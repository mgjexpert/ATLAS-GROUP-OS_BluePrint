# Copy to /etc/atlas/atlas-agent-engine.env and chmod 600.
# Never commit the populated file.

# FCC server: local-only.
HOST=127.0.0.1
PORT=8082
FCC_OPEN_BROWSER=false
PROXY_AUTH_ENABLED=true

# Replace with a strong random value in the real file.
ANTHROPIC_AUTH_TOKEN=CHANGE_ME_RANDOM_LOCAL_PROXY_TOKEN

# Provider
OPENROUTER_API_KEY=CHANGE_ME

# Free-first baseline. Availability is volatile and must be verified at deployment.
MODEL=open_router/openrouter/free

# Conservative provider concurrency for V0.
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=2
PROVIDER_MAX_CONCURRENCY=1

# No messaging surface in V0.
MESSAGING_PLATFORM=none
VOICE_NOTE_ENABLED=false

# Keep logs metadata-focused.
LOG_LEVEL=INFO
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false
LOG_RAW_MESSAGING_CONTENT=false
LOG_RAW_CLI_DIAGNOSTICS=false
LOG_MESSAGING_ERROR_DETAILS=false

# Claude Code/FCC local proxy variables used by the harness.
ANTHROPIC_BASE_URL=http://127.0.0.1:8082
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1


# Atlas.Dev-00 V0: keep ECC skills/commands, disable automatic hook side effects.
# Re-enable only after the observe/recommend mission is reviewed.
ECC_HOOKS_ENABLED=false
ECC_HOOK_PROFILE=minimal
