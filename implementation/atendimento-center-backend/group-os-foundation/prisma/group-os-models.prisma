// Append these models to prisma/schema.prisma after adding
// "portfolio", "governance" and "finops" to datasource.schemas.

model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  status         String   @default("active")
  mandate        String?  @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("business_units")
  @@schema("core")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessUnitId String   @map("business_unit_id") @db.Uuid
  code           String
  name           String
  kind           String   @default("venture")
  status         String   @default("active")
  mandate        String?  @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@index([businessUnitId, status])
  @@map("branches")
  @@schema("core")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessUnitId String?  @map("business_unit_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  code           String
  name           String
  status         String   @default("active")
  mandate        String?  @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@index([branchId, status])
  @@map("teams")
  @@schema("core")
}

model TeamMembership {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  memberType String   @map("member_type")
  agentId    String?  @map("agent_id") @db.Uuid
  authUserId String?  @map("auth_user_id") @db.Uuid
  role       String   @default("member")
  isManager  Boolean  @default(false) @map("is_manager")
  active     Boolean  @default(true)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([teamId, active])
  @@map("team_memberships")
  @@schema("core")
}

model PortfolioProject {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  businessUnitId  String?   @map("business_unit_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  code            String
  name            String
  status          String    @default("planned")
  ownerType       String?   @map("owner_type")
  ownerId         String?   @map("owner_id")
  objective       String?   @db.Text
  successCriteria Json      @default("[]") @map("success_criteria")
  riskLevel       String    @default("medium") @map("risk_level")
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  targetAt        DateTime? @map("target_at") @db.Timestamptz(6)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@index([organizationId, status, updatedAt(sort: Desc)])
  @@map("projects")
  @@schema("portfolio")
}

model PortfolioGoal {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  parentGoalId    String?   @map("parent_goal_id") @db.Uuid
  title           String
  status          String    @default("planned")
  priority        Int       @default(100)
  successCriteria Json      @default("[]") @map("success_criteria")
  ownerType       String?   @map("owner_type")
  ownerId         String?   @map("owner_id")
  targetAt        DateTime? @map("target_at") @db.Timestamptz(6)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status, priority])
  @@map("goals")
  @@schema("portfolio")
}

model PortfolioTask {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  goalId           String?   @map("goal_id") @db.Uuid
  parentTaskId     String?   @map("parent_task_id") @db.Uuid
  title            String
  description      String?   @db.Text
  status           String    @default("backlog")
  priority         Int       @default(100)
  assigneeType     String?   @map("assignee_type")
  assigneeId       String?   @map("assignee_id")
  riskLevel        String    @default("low") @map("risk_level")
  approvalRequired Boolean   @default(false) @map("approval_required")
  dueAt            DateTime? @map("due_at") @db.Timestamptz(6)
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status, priority])
  @@map("tasks")
  @@schema("portfolio")
}

model GovernanceDecision {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  taskId           String?   @map("task_id") @db.Uuid
  title            String
  proposal         String?   @db.Text
  alternatives     Json      @default("[]")
  risks            Json      @default("[]")
  decision         String?   @db.Text
  status           String    @default("proposed")
  proposedByType   String?   @map("proposed_by_type")
  proposedById     String?   @map("proposed_by_id")
  decidedByType    String?   @map("decided_by_type")
  decidedById      String?   @map("decided_by_id")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("decisions")
  @@schema("governance")
}

model GovernancePolicy {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String?  @map("organization_id") @db.Uuid
  code              String
  name              String
  version           Int      @default(1)
  status            String   @default("draft")
  scope             String   @default("organization")
  rule              Json     @default("{}")
  immutableByAgents Boolean  @default(true) @map("immutable_by_agents")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, code, version])
  @@map("policies")
  @@schema("governance")
}

model ApprovalRequest {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  runId           String?   @map("run_id") @db.Uuid
  actionId        String?   @map("action_id") @db.Uuid
  status          String    @default("pending")
  riskLevel       String    @default("medium") @map("risk_level")
  requestedByType String    @map("requested_by_type")
  requestedById   String?   @map("requested_by_id")
  approverClass   String    @map("approver_class")
  reason          String?   @db.Text
  expectedEffect  String?   @map("expected_effect") @db.Text
  reversibility   String?
  policyIds       Json      @default("[]") @map("policy_ids")
  payload         Json      @default("{}")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status, riskLevel, createdAt])
  @@map("approval_requests")
  @@schema("governance")
}

model ApprovalDecision {
  id                String   @id @default(uuid()) @db.Uuid
  approvalRequestId String   @unique @map("approval_request_id") @db.Uuid
  decision          String
  actorType         String   @map("actor_type")
  actorId           String?  @map("actor_id")
  reason            String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("approval_decisions")
  @@schema("governance")
}

model CostCenter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  status         String   @default("active")
  ownerType      String?  @map("owner_type")
  ownerId        String?  @map("owner_id")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@map("cost_centers")
  @@schema("finops")
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  costCenterId   String?  @map("cost_center_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  currency       String   @default("USD")
  amount         Decimal  @db.Decimal(18, 6)
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  status         String   @default("active")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, periodStart, periodEnd])
  @@map("budgets")
  @@schema("finops")
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  costCenterId   String?  @map("cost_center_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  runId          String?  @map("run_id") @db.Uuid
  provider       String?
  model          String?
  usageType      String   @map("usage_type")
  quantity       Decimal  @default(0) @db.Decimal(24, 8)
  amount         Decimal? @db.Decimal(18, 8)
  currency       String   @default("USD")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([runId])
  @@map("usage_records")
  @@schema("finops")
}
